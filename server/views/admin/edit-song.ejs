<%- include('../partials/header') %>

<div style="max-width: 600px; margin: 30px auto; padding: 20px; background: #121212; border-radius: 8px;">
    <h2>Edit Song: <%= song.title %></h2>
    
    <form action="/admin/songs/edit/<%= song._id %>" method="POST" enctype="multipart/form-data" style="margin-top: 20px;">
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">Song Title</label>
            <input type="text" name="title" value="<%= song.title %>" required style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">Artist</label>
            <input type="text" name="artist" value="<%= song.artist %>" required style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">Genre</label>
            <select name="genre" required style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
                <option value="Pop" <%= song.genre === 'Pop' ? 'selected' : '' %>>Pop</option>
                <option value="Rock" <%= song.genre === 'Rock' ? 'selected' : '' %>>Rock</option>
                <option value="Hip Hop" <%= song.genre === 'Hip Hop' ? 'selected' : '' %>>Hip Hop</option>
                <option value="Jazz" <%= song.genre === 'Jazz' ? 'selected' : '' %>>Jazz</option>
                <option value="Electronic" <%= song.genre === 'Electronic' ? 'selected' : '' %>>Electronic</option>
            </select>
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">Duration (M:SS)</label>
            <input type="text" name="duration" value="<%= song.duration %>" required style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">Album Art (Image) - Leave blank to keep current</label>
            <img src="<%= song.albumArt %>" style="width: 60px; height: 60px; margin-bottom: 10px; border-radius: 4px;">
            <input type="file" name="albumArt" accept="image/*" style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
        </div>
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 5px;">Audio File - Leave blank to keep current</label>
            <p style="font-size: 0.8em; color: #b3b3b3; margin-bottom: 10px;">Current file: <%= song.audioUrl %></p>
            <input type="file" name="audioFile" accept="audio/*" style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #282828; color: white;">
        </div>
        
        <div style="display: flex; gap: 10px;">
            <button type="submit" class="loginButton" style="flex: 1; padding: 12px; font-weight: bold; cursor: pointer;">Update Song</button>
            <a href="/admin/dashboard" style="flex: 1; padding: 12px; text-align: center; background: #282828; color: white; border-radius: 20px; text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
