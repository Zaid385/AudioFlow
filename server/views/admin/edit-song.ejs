<%- include('../partials/header') %>

<div class="admin-form-card">
    <h2>Edit Song: <%= song.title %></h2>
    
    <form action="/admin/songs/edit/<%= song._id %>" method="POST" enctype="multipart/form-data" class="admin-form-box">
        <div class="form-group">
            <label class="form-label">Song Title</label>
            <input type="text" name="title" value="<%= song.title %>" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Artist</label>
            <input type="text" name="artist" value="<%= song.artist %>" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Genre</label>
            <select name="genre" required class="form-select form-select-full">
                <option value="Pop" <%= song.genre === 'Pop' ? 'selected' : '' %>>Pop</option>
                <option value="Rock" <%= song.genre === 'Rock' ? 'selected' : '' %>>Rock</option>
                <option value="Hip Hop" <%= song.genre === 'Hip Hop' ? 'selected' : '' %>>Hip Hop</option>
                <option value="Jazz" <%= song.genre === 'Jazz' ? 'selected' : '' %>>Jazz</option>
                <option value="Electronic" <%= song.genre === 'Electronic' ? 'selected' : '' %>>Electronic</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Duration (M:SS)</label>
            <input type="text" name="duration" value="<%= song.duration %>" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Album Art (Image) - Leave blank to keep current</label>
            <img src="<%= song.albumArt %>" class="form-img-preview">
            <input type="file" name="albumArt" accept="image/*" class="form-input">
        </div>
        <div class="form-group-large">
            <label class="form-label">Audio File - Leave blank to keep current</label>
            <p class="form-help-text">Current file: <%= song.audioUrl %></p>
            <input type="file" name="audioFile" accept="audio/*" class="form-input">
        </div>
        
        <div class="form-actions-row">
            <button type="submit" class="loginButton btn-auth-full">Update Song</button>
            <a href="/admin/dashboard" class="btn-secondary-pill">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
