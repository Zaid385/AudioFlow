<%- include('../partials/header') %>

<div style="padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h2>Admin Music Management</h2>
        <a href="/admin/songs/add" class="loginButton" style="text-decoration: none; padding: 10px 20px; border-radius: 20px;">Add New Song</a>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; background: #181818; border-radius: 8px; overflow: hidden;">
            <thead>
                <tr style="background: #282828; text-align: left;">
                    <th style="padding: 15px;">Song</th>
                    <th style="padding: 15px;">Artist</th>
                    <th style="padding: 15px;">Genre</th>
                    <th style="padding: 15px;">Duration</th>
                    <th style="padding: 15px;">Plays</th>
                    <th style="padding: 15px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% songs.forEach(song => { %>
                    <tr style="border-bottom: 1px solid #333;">
                        <td style="padding: 15px; display: flex; align-items: center; gap: 10px;">
                            <img src="<%= song.albumArt %>" style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover;">
                            <span><%= song.title %></span>
                        </td>
                        <td style="padding: 15px;"><%= song.artist %></td>
                        <td style="padding: 15px;"><%= song.genre %></td>
                        <td style="padding: 15px;"><%= song.duration %></td>
                        <td style="padding: 15px;"><%= song.playCount %></td>
                        <td style="padding: 15px;">
                            <div style="display: flex; gap: 10px;">
                                <a href="/admin/songs/edit/<%= song._id %>" style="color: #1db954; text-decoration: none;">Edit</a>
                                <form action="/admin/songs/delete/<%= song._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this song?')">
                                    <button type="submit" style="background: transparent; border: none; color: #ff4444; cursor: pointer; padding: 0;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                <% if (songs.length === 0) { %>
                    <tr>
                        <td colspan="6" style="padding: 30px; text-align: center; color: #b3b3b3;">No songs found in the library.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
