<%- include('../partials/header') %>

<div class="admin-container">
    <div class="admin-header-row">
        <h2 class="admin-section-title compact">Admin Music Management</h2>
        <a href="/admin/songs/add" class="btn-login btn-login-small">Add New Song</a>
    </div>

    <div class="table-responsive">
        <table class="admin-dashboard-table">
            <thead>
                <tr class="table-head-row">
                    <th class="table-th-large">Song</th>
                    <th class="table-th-large">Artist</th>
                    <th class="table-th-large">Genre</th>
                    <th class="table-th-large">Duration</th>
                    <th class="table-th-large">Plays</th>
                    <th class="table-th-large">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% songs.forEach(song => { %>
                    <tr class="table-body-row">
                        <td class="table-td-flex">
                            <img src="<%= song.albumArt %>" class="table-img-small">
                            <span><%= song.title %></span>
                        </td>
                        <td class="table-td-large"><%= song.artist %></td>
                        <td class="table-td-large"><%= song.genre %></td>
                        <td class="table-td-large"><%= song.duration %></td>
                        <td class="table-td-large"><%= song.playCount %></td>
                        <td class="table-td-large">
                            <div class="actions-cell-flex">
                                <a href="/admin/songs/edit/<%= song._id %>" class="link-success">Edit</a>
                                <form action="/admin/songs/delete/<%= song._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this song?')">
                                    <button type="submit" class="btn-link-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                <% if (songs.length === 0) { %>
                    <tr>
                        <td colspan="6" class="table-empty-td">No songs found in the library.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
