<div class="mobile-fs-header">
    <button id="minimizePlayerBtn" class="player-minimize-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"></path></svg>
    </button>
    <div class="player-fs-title">Now Playing</div>
    <div class="player-fs-spacer"></div>
</div>

<div class="player-left player-section-left">
    <div class="player-album-art player-art-box">
        <img id="playerTrackArt" src="" class="player-art-img">
    </div>
    <div class="mobile-track-details player-track-details-mobile">
        <div class="player-track-info player-track-info-box">
            <div id="playerTrackTitle" class="player-track-title">Select a song</div>
            <div id="playerTrackArtist" class="player-track-artist"></div>
        </div>
        <button id="playerLikeBtn" class="player-like-btn">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1.69 2A4.582 4.582 0 0 1 8 2.023 4.583 4.583 0 0 1 14.31 2c1.908 0 3.182 1.534 3.182 3.286 0 1.98-.863 3.357-2.362 4.602l-7.13 5.903-7.13-5.903C.553 8.643-.31 7.266-.31 5.286-.31 3.534.965 2 2.872 2h-1.182z"></path></svg>
        </button>
    </div>
</div>

<div class="player-center player-section-center">
    <div class="player-controls player-controls-row">
        <button id="playerPrevBtn" class="player-control-btn"><svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3.3 1a.7.7 0 0 1 .7.7v5.15l9.95-5.744a.7.7 0 0 1 1.05.606v12.575a.7.7 0 0 1-1.05.607L4 9.149V14.3a.7.7 0 0 1-1.4 0V1.7a.7.7 0 0 1 .7-.7z"></path></svg></button>
        <button id="playerPlayPauseBtn" class="player-play-btn">
            <svg id="playIcon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713z"></path></svg>
            <svg id="pauseIcon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="icon-hidden"><path d="M2.7 1a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7H2.7zm7.4 0a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7h-2.6z"></path></svg>
        </button>
        <button id="playerNextBtn" class="player-control-btn"><svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.107A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V14.3a.7.7 0 0 0 1.4 0V1.7a.7.7 0 0 0-.7-.7z"></path></svg></button>
    </div>
    <div class="player-progress-area player-progress-box">
        <span id="currentTime" class="player-time current">0:00</span>
        <div id="progressBarContainer" class="player-bar-container">
            <div id="progressBar" class="player-bar-fill"></div>
        </div>
        <span id="durationTime" class="player-time">0:00</span>
    </div>
</div>

<div class="player-right player-section-right">
    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="player-vol-icon"><path d="M12.945 1.379l-.652.763c1.577 1.462 2.57 3.544 2.57 5.858s-.994 4.396-2.57 5.858l.651.763a8.966 8.966 0 0 0 3.056-6.621 8.967 8.967 0 0 0-3.055-6.621z"></path><path d="M10.548 4.197l-.663.746c.767.761 1.24 1.813 1.24 2.97 0 1.157-.473 2.209-1.24 2.97l.663.746A5.221 5.221 0 0 0 12.125 8a5.221 5.221 0 0 0-1.577-3.803z"></path><path d="M7.389 2.021a.5.5 0 0 0-.5 0L2.284 4.54a.5.5 0 0 0-.284.449v6.022a.5.5 0 0 0 .284.449l4.605 2.519a.5.5 0 0 0 .5 0V2.021z"></path></svg>
    <div id="volumeBarContainer" class="player-vol-container">
        <div id="volumeBar" class="player-vol-fill"></div>
    </div>
</div>

<div class="mobile-fs-details" id="mobileFullscreenDetails">
    <!-- Populated by main.ts -->
</div>

<audio id="mainAudioElement" preload="auto" crossorigin="anonymous"></audio>
