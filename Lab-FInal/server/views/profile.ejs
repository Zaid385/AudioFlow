<%- include('partials/header') %>

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-avatar">
            <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div class="profile-info">
            <p class="badge-text">Profile</p>
            <h1 class="profile-name"><%= user.name %></h1>
            <p class="profile-meta-text"><%= user.email %> • <%= user.role %></p>
        </div>
    </div>

    <div class="profile-settings-card">
        <h2 class="section-title-spaced">Account Settings</h2>
        
        <form action="/profile" method="POST">
            <div class="form-group-large">
                <label class="form-label">Name</label>
                <input type="text" name="name" value="<%= user.name %>" required class="form-input">
            </div>
            
            <div class="form-group-large">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" value="<%= user.email %>" required class="form-input">
            </div>
            
            <div class="profile-actions">
                <button type="submit" class="btn-login">Save Changes</button>
                <a href="/logout" class="btn-logout">Log Out</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
