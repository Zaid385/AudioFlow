<%- include('../partials/header') %>

<div class="admin-form-card">
    <h2>Add New Song</h2>
    
    <form action="/admin/songs/add" method="POST" enctype="multipart/form-data" class="admin-form-box">
        <div class="form-group">
            <label class="form-label">Song Title</label>
            <input type="text" name="title" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Artist</label>
            <input type="text" name="artist" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Genre</label>
            <select name="genre" required class="form-select form-select-full">
                <option value="Pop">Pop</option>
                <option value="Rock">Rock</option>
                <option value="Hip Hop">Hip Hop</option>
                <option value="Jazz">Jazz</option>
                <option value="Electronic">Electronic</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Duration (M:SS)</label>
            <input type="text" name="duration" placeholder="3:45" required class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">Album Art (Image)</label>
            <input type="file" name="albumArt" accept="image/*" required class="form-input">
        </div>
        <div class="form-group-large">
            <label class="form-label">Audio File</label>
            <input type="file" name="audioFile" accept="audio/*" required class="form-input">
        </div>
        
        <div class="form-actions-row">
            <button type="submit" class="loginButton btn-auth-full">Add Song</button>
            <a href="/admin/dashboard" class="btn-secondary-pill">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
