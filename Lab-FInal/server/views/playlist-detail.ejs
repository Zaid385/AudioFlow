<%- include('partials/header') %>

<div class="playlist-detail-container playlist-detail-header-bg">
    <div class="playlist-header">
        <div class="playlist-art-large playlist-header-img">
            <% if (playlist.songs.length >= 4) { %>
                <div class="playlist-cover grid-4">
                    <img src="<%= playlist.songs[0].coverUrl || playlist.songs[0].albumArt %>">
                    <img src="<%= playlist.songs[1].coverUrl || playlist.songs[1].albumArt %>">
                    <img src="<%= playlist.songs[2].coverUrl || playlist.songs[2].albumArt %>">
                    <img src="<%= playlist.songs[3].coverUrl || playlist.songs[3].albumArt %>">
                </div>
            <% } else if (playlist.songs.length === 3) { %>
                <div class="playlist-cover grid-3">
                    <img src="<%= playlist.songs[0].coverUrl || playlist.songs[0].albumArt %>">
                    <img src="<%= playlist.songs[1].coverUrl || playlist.songs[1].albumArt %>">
                    <img src="<%= playlist.songs[2].coverUrl || playlist.songs[2].albumArt %>">
                </div>
            <% } else if (playlist.songs.length === 2) { %>
                <div class="playlist-cover grid-2">
                    <img src="<%= playlist.songs[0].coverUrl || playlist.songs[0].albumArt %>">
                    <img src="<%= playlist.songs[1].coverUrl || playlist.songs[1].albumArt %>">
                </div>
            <% } else if (playlist.songs.length === 1) { %>
                <div class="playlist-cover single">
                    <img src="<%= playlist.songs[0].coverUrl || playlist.songs[0].albumArt %>">
                </div>
            <% } else { %>
                <div class="playlist-cover placeholder">
                    <img src="/images/Your_Library.svg" class="playlist-placeholder-icon-large">
                </div>
            <% } %>
        </div>
        <div class="playlist-header-info">
            <p class="badge-text">Playlist</p>
            <h1 class="playlist-title-text"><%= playlist.name %></h1>
            <p class="playlist-meta-text">
                <%= user.name %> • <%= playlist.songs.length %> songs
            </p>
        </div>
    </div>

    <div class="playlist-actions-row">
        <button id="playlistPlayAll" class="btn-play-all">
            <svg width="24" height="24" fill="black" viewBox="0 0 24 24"><path d="M7.05 3.606l13.49 7.788a.7.7 0 0 1 0 1.212L7.05 20.394A.7.7 0 0 1 6 19.788V4.212a.7.7 0 0 1 1.05-.606z"></path></svg>
        </button>
        <% if (playlist.name !== 'Liked Songs') { %>
            <form action="/playlists/delete/<%= playlist._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this playlist?')">
                <button type="submit" class="btn-icon-danger">
                    <svg width="32" height="32" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z"></path><path d="M12 8.75H4v-1.5h8v1.5z"></path></svg>
                </button>
            </form>
        <% } %>
    </div>

    <table class="playlist-table">
        <thead class="table-head">
            <tr>
                <th class="table-th col-index">#</th>
                <th class="table-th">Title</th>
                <th class="table-th col-artist">Artist</th>
                <th class="table-th col-duration">Duration</th>
                <th class="table-th col-actions"></th>
            </tr>
        </thead>
        <tbody>
            <% playlist.songs.forEach((song, index) => { %>
                <tr class="playlist-row">
                    <td class="table-td table-td-muted col-index"><%= index + 1 %></td>
                    <td class="table-td table-td-flex-small">
                        <img src="<%= song.coverUrl || song.albumArt %>" class="table-img-tiny">
                        <div class="truncate-box">
                            <div class="track-name"><%= song.title %></div>
                            <div class="track-artist-mobile"><%= song.artist %></div>
                        </div>
                    </td>
                    <td class="table-td table-td-muted col-artist"><%= song.artist %></td>
                    <td class="table-td table-td-muted col-duration"><%= song.duration %></td>
                    <td class="table-td col-actions">
                        <div class="track-actions">
                            <button class="play-btn btn-track-play" data-song='{"id":"<%= song._id %>","title":"<%= song.title %>","artist":"<%= song.artist %>","albumArt":"<%= song.coverUrl || song.albumArt %>","audioUrl":"<%= song.audioUrl %>"}'>
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713z"></path></svg>
                            </button>
                            <form action="/playlists/<%= playlist._id %>/remove/<%= song._id %>" method="POST">
                                <button type="submit" class="btn-text-muted">Remove</button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }) %>
            <% if (playlist.songs.length === 0) { %>
                <tr>
                    <td colspan="5" class="table-empty-td">
                        <p class="empty-title">Playlist is empty</p>
                        <p>Go to search or home to add some music!</p>
                        <a href="/songs" class="btn-login btn-empty-action">Find Songs</a>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/footer') %>
