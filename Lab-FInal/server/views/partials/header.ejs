<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AudioFlow - <%= title %></title>
    <link rel="icon" type="image/icon" href="/images/AudioFLow_icon_green.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- CSS Architecture -->
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components/buttons.css">
    <link rel="stylesheet" href="/css/components/forms.css">
    <link rel="stylesheet" href="/css/components/cards.css">
    <link rel="stylesheet" href="/css/components/modals.css">
    <link rel="stylesheet" href="/css/components/tables.css">
    <link rel="stylesheet" href="/css/components/navbar.css">
    <link rel="stylesheet" href="/css/pages/player.css">
    <link rel="stylesheet" href="/css/pages/admin.css">
    <link rel="stylesheet" href="/css/pages/playlists.css">
    <link rel="stylesheet" href="/css/pages/profile.css">
    <link rel="stylesheet" href="/css/pages/auth.css">
    <script src="https://unpkg.com/fast-average-color/dist/index.browser.min.js"></script>
</head>
<body>
    
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="app-container <%= user ? 'user-logged-in' : 'user-logged-out' %>">
        <!-- Resize Handles -->
        <div class="resize-handle resize-handle-left" id="sidebarResizer"></div>
        <% if (user) { %>
            <div class="resize-handle resize-handle-right" id="panelResizer"></div>
        <% } %>

        <!-- Left Sidebar -->
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <a href="/" class="<%= title === 'Home' ? 'active' : '' %>">
                    <img src="/images/Home.svg" width="24" height="24">
                    Home
                </a>
                <a href="/songs" class="<%= title === 'Music Library' ? 'active' : '' %>">
                    <img src="/images/Search.svg" width="24" height="24">
                    Search
                </a>
                <% if (user && user.role === 'admin') { %>
                    <a href="/admin/manage-songs" class="<%= title === 'Manage Songs' ? 'active' : '' %> admin-nav-link">
                        <img src="/images/Your_Library.svg" width="24" height="24" class="admin-nav-icon">
                        Manage Songs
                    </a>
                    <a href="/sales" class="<%= title === 'Sales Dashboard' ? 'active' : '' %> admin-nav-link">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24" style="margin-right: 12px;"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z"/></svg>
                        Sales Dashboard
                    </a>
                <% } %>
            </nav>

            <div class="sidebar-library">
                <header class="library-header">
                    <a href="/playlists" class="library-link">
                        <img src="/images/Your_Library.svg" width="24" height="24">
                        Your Library
                    </a>
                    <% if (user) { %>
                        <div id="createPlaylistBtn" class="add-playlist-btn">+</div>
                    <% } %>
                </header>

                <div id="playlistList" class="playlist-list">
                    <% if (user) { %>
                        <p id="playlistPlaceholder" class="playlist-placeholder">Your playlists will appear here.</p>
                    <% } else { %>
                        <div class="empty-library-card">
                            <p class="empty-library-title">Create your first playlist</p>
                            <p class="empty-library-subtitle">It's easy, we'll help you</p>
                            <a href="/login" class="btn-login empty-library-btn">Log in</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </aside>

        <!-- Main View -->
        <main class="main-view">
            <header class="top-bar">
                <div class="nav-left-spacer">
                    <div class="mobile-only-header">
                        <img src="/images/AudioFLow_icon_white.svg" height="32" width="32" alt="Logo">
                    </div>
                </div>

                <div class="nav-center">
                    <form action="/songs" method="GET" class="searchBar">
                        <img src="/images/Search.svg" alt="search">
                        <input type="text" name="search" placeholder="What do you want to play?" value="<%= typeof search !== 'undefined' ? search : '' %>" autocomplete="off">
                    </form>
                    <div id="searchSuggestions" class="search-suggestions-box">
                        <!-- Suggestions populated via JS -->
                    </div>
                </div>

                <div class="auth-actions desktop-only">
                    <% if (user) { %>
                        <div class="user-profile-actions">
                            <% if (user.role === 'admin') { %>
                                <a href="/admin/manage-songs" class="admin-manage-link">Manage Songs</a>
                            <% } %>
                            <a href="/profile" class="profile-pill profile-pill-link">
                                <div class="profile-avatar-small">
                                    <%= user.name.charAt(0).toUpperCase() %>
                                </div>
                                <span class="profile-name-small"><%= user.name %></span>
                            </a>
                        </div>
                    <% } else { %>
                        <a href="/register" class="btn-signup">Sign up</a>
                        <a href="/login" class="btn-login">Log in</a>
                    <% } %>
                </div>
                
                <div class="mobile-hamburger mobile-only">
                    <button id="mobileMenuBtn" class="mobile-menu-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"></path></svg>
                    </button>
                </div>
            </header>

            <!-- Mobile Hamburger Menu Overlay -->
            <div id="mobileMenuOverlay" class="mobile-menu-overlay">
                <div class="mobile-menu-content">
                    <button id="closeMobileMenuBtn" class="close-menu-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"></path></svg>
                    </button>
                    <% if (user) { %>
                        <a href="/profile" class="mobile-menu-link">
                            <div class="profile-avatar-medium">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                            <span>Profile</span>
                        </a>
                        <% if (user.role === 'admin') { %>
                            <a href="/admin/manage-songs" class="mobile-menu-link">Manage Songs</a>
                            <a href="/sales" class="mobile-menu-link">Sales Dashboard</a>
                        <% } %>
                        <a href="/logout" class="mobile-menu-link">Log out</a>
                    <% } else { %>
                        <a href="/login" class="mobile-menu-link">Log in</a>
                        <a href="/register" class="mobile-menu-link">Sign up</a>
                    <% } %>
                </div>
            </div>

            <div class="main-content">
